# --- PostgreSQL ---
POSTGRES_USER=greenhouse
POSTGRES_PASSWORD=greenhouse_dev_password
POSTGRES_DB=greenhouse
# Internal container port (do not change)
POSTGRES_PORT=5432
# Host port mapped to container's 5432 (avoids conflict with local Postgres on 5432)
POSTGRES_HOST_PORT=5433
# Inside Docker, backend reaches Postgres via the service name `postgres`
POSTGRES_HOST=postgres

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# --- Simulator ---
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_ANOMALY_PROBABILITY=0.02
SIMULATOR_LOG_LEVEL=INFO


# --- Analytics ---
ANALYTICS_OVERVIEW_WINDOW_HOURS=24
ANALYTICS_WARNING_TOLERANCE_PERCENT=15.0


# --- Alerts & anomaly detection ---
ALERT_EVALUATION_ENABLED=true
ALERT_CO2_MIN_PPM=400
ALERT_CO2_MAX_PPM=1500
ANOMALY_WINDOW_SIZE=60
ANOMALY_ZSCORE_THRESHOLD=4.0

AIRFLOW_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8081
AIRFLOW_UID=50000
FRONTEND_PORT=5174


# --- ML ---
# Path inside the backend container where the trained model is mounted.
ML_MODEL_DIR=/app/ml_models


# --- MLflow ---
# Host port for the MLflow UI (5000 is often taken by macOS AirPlay Receiver)
MLFLOW_PORT=5001
# In-network URL used by the backend and training scripts run inside Docker
MLFLOW_TRACKING_URI=http://mlflow:5000
# Registered model name in the MLflow Model Registry
MLFLOW_MODEL_NAME=greenhouse-yield-predictor
# Stage the backend reads from
MLFLOW_MODEL_STAGE=Production


# --- Authentication ---
# CHANGE THIS IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-please-use-64-plus-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap admin (used once, at first startup, if no users exist).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
BOOTSTRAP_ADMIN_FULL_NAME=Admin User